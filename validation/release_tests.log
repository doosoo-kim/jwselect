. do tests/csdid_adapter.do

. *! jwselect 0.5.0: CS-DR transport, validation, and state-preservation tests
. *! Run from package root in a fresh test session. Does not need csdid installed.
. version 16.1

. set more off

. adopath ++ "."
  [1]              "."
  [2]  (BASE)      "C:\Program Files\Stata17\ado\base/"
  [3]  (SITE)      "C:\Program Files\Stata17\ado\site/"
  [4]  (PERSONAL)  "C:\Users\Doosoo Kim\ado\personal/"
  [5]  (PLUS)      "C:\Users\Doosoo Kim\ado\plus/"
  [6]  (OLDPLACE)  "c:\ado/"

. 
. capture mata: mata drop jw_csf_fixture()

. mata:
------------------------------------------------- mata (type end to exit) ------------------------------------------------------------------
: void jw_csf_fixture(string scalar bname, string scalar vname, string scalar aname,
>     real scalar anti, real scalar permuted)
> {
>     real matrix csA, csV
>     real rowvector csB, csOrd
>     real scalar csJ, csI, csG, csT, csBase
>     string matrix csNames
>     csA = J(16,10,0)
>     csB = J(1,14,0)
>     csV = I(14)*.02 + J(14,14,.003)
>     csNames = J(14,2,"")
>     csJ = 0
>     for (csI=1; csI<=16; csI++) {
>         csG = csI<=8 ? 4 : 6
>         csT = mod(csI-1,8)+1
>         csBase = csG-anti-1
>         csA[csI,.] = (csG,csT,csT-csG,0,.,20,20,20,20,csBase)
>         if (csT!=csBase) {
>             csJ++
>             csB[csJ] = csT>=csG ? .4+.03*csG+.02*csT : .015*(csT-csBase)
>             csA[csI,4] = csB[csJ]
>             csA[csI,5] = sqrt(csV[csJ,csJ])
>             csNames[csJ,2] = sprintf("g%g___%g_%g",csG,csT,csBase)
>         }
>     }
>     if (permuted) {
>         csOrd = (14..1)
>         csB = csB[,csOrd]
>         csV = csV[csOrd,csOrd]
>         csNames = csNames[csOrd',.]
>         csA = csA[(16..1)',.]
>     }
>     st_matrix(bname,csB)
>     st_matrix(vname,csV)
>     st_matrix(aname,csA)
>     st_matrixcolstripe(bname,csNames)
>     st_matrixcolstripe(vname,csNames)
>     st_matrixrowstripe(vname,csNames)
> }

: end
--------------------------------------------------------------------------------------------------------------------------------------------

. 
. capture program drop _jw_cs_fixture

. program define _jw_cs_fixture, eclass
  1.     version 16.1
  2.     syntax [, PERMuted ANTI(integer 0)]
  3.     tempname B V A
  4.     tempvar sample
  5.     quietly generate byte `sample' = 1
  6.     mata: jw_csf_fixture("`B'", "`V'", "`A'", `anti', "`permuted'"!="")
  7.     matrix colnames `A' = group time event_time att se n_treat_t n_treat_pre n_control_t n_control_pre base_time
  8.     ereturn post `B' `V', esample(`sample') obs(480)
  9.     ereturn matrix attgt = `A'
 10.     ereturn local cmdline "csdid y x, ivar(id) time(time) gvar(group) method(dr) nevertreated base_period(universal) analytical pointwi
> se anticipation(`anti')"
 11.     ereturn local version "2.0.1"
 12.     ereturn local method "dr"
 13.     ereturn local control_group "nevertreated"
 14.     ereturn local base_period "universal"
 15.     ereturn local panel_mode "panel"
 16.     ereturn local idvar "id"
 17.     ereturn local timevar "time"
 18.     ereturn local gvar "group"
 19.     ereturn local depvar "y"
 20.     ereturn local vce "analytical"
 21.     ereturn scalar bstrap = 0
 22.     ereturn scalar N_units = 60
 23.     ereturn scalar N_time = 8
 24.     ereturn scalar N_groups = 2
 25.     ereturn scalar anticipation = `anti'
 26.     ereturn scalar pscoretrim = .995
 27.     ereturn scalar level = 95
 28.     quietly signestimationsample id time group y x
 29.     ereturn local cmd "csdid"
 30. end

. 
. capture program drop _jw_cs_local

. program define _jw_cs_local, eclass
  1.     args key val
  2.     ereturn local `key' "`val'"
  3. end

. capture program drop _jw_cs_scalar

. program define _jw_cs_scalar, eclass
  1.     args key val
  2.     ereturn scalar `key' = `val'
  3. end

. capture program drop _jw_cs_badtable

. program define _jw_cs_badtable, eclass
  1.     args bad
  2.     tempname A
  3.     matrix `A' = e(attgt)
  4.     if "`bad'" == "normalization" matrix `A'[3,4] = .1
  5.     if "`bad'" == "duplicate" matrix `A'[2,1] = 4
  6.     if "`bad'" == "duplicate" matrix `A'[2,2] = 1
  7.     if "`bad'" == "duplicate" matrix `A'[2,3] = -3
  8.     if "`bad'" == "missing" matrix `A'[1,4] = .
  9.     if "`bad'" == "se" matrix `A'[1,5] = 0
 10.     if "`bad'" == "base" matrix `A'[1,10] = 2
 11.     ereturn matrix attgt = `A'
 12. end

