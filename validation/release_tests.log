. local old_rng `c(rngstate)'

. local caseno 0

. foreach family in all nested {
  2.     foreach scope in cohort aggregate both {
  3.         local ++caseno
  4.         local jobdir `"`outdir'/case_`family'_`scope'"'
  5.         local config `input' select(focused) candidates(`family') focus(`scope') `numerical'
  6.         display as text "CASE `caseno': family=`family', focus=`scope'"
  7. 
.         // Serial, uncached: the comparison includes fixed-action SE and inference.
.         jwselect, `config' inference(reselect) cachemb(0)
  8.         assert `"`c(rngstate)'"' == `"`old_rng'"'
  9.         matrix JW030_SERIAL = e(table)
 10.         matrix JW030_DIAG = e(inference_diagnostics)
 11.         matrix JW030_EXT = e(inference_extrema)
 12.         matrix JW030_MAP = e(output_map)
 13.         matrix JW030_B = e(b)
 14.         matrix JW030_V = e(V_fixed)
 15.         mata: assert(!hasmissing(st_matrix("JW030_SERIAL")))
 16.         mata: assert(all(st_matrix("JW030_SERIAL")[.,3]:<=st_matrix("JW030_SERIAL")[.,4]))
 17.         mata: assert(all(st_matrix("JW030_SERIAL")[.,5]:>=0) & all(st_matrix("JW030_SERIAL")[.,5]:<=1))
 18.         mata: assert(all(st_matrix("JW030_DIAG")[.,6]:<=80))
 19. 
.         // A positive cache budget may change storage, never the statistical rule.
.         jwselect, `config' inference(reselect) cachemb(64)
 20.         mata: jw030_equal("e(table)","JW030_SERIAL",1e-10)
 21.         mata: jw030_equal("e(inference_diagnostics)","JW030_DIAG",1e-10)
 22.         mata: jw030_equal("e(inference_extrema)","JW030_EXT",1e-10)
 23.         assert `"`c(rngstate)'"' == `"`old_rng'"'
 24. 
.         // Preparation freezes inputs/draws but does not run numerical inference.
.         jwselect, `config' inference(none) prepare(`"`jobdir'"') cachemb(64)
 25.         matrix JW030_PREP_B = e(b)
 26.         assert `"`c(rngstate)'"' == `"`old_rng'"'
 27.         mata: jw030_equal("e(b)","JW030_B",1e-10)
 28.         mata: jw030_equal("e(V_fixed)","JW030_V",1e-10)
 29.         capture noisily jwselect_collect using `"`jobdir'"'
 30.         assert _rc != 0
 31.         assert `"`c(rngstate)'"' == `"`old_rng'"'
 32. 
.         // Frozen preparations cannot be overwritten accidentally.
.         capture noisily jwselect, `config' inference(none) prepare(`"`jobdir'"')
 33.         assert _rc != 0
 34.         mata: jw030_equal("e(b)","JW030_PREP_B",1e-10)
 35. 
.         // A competing session's lock must fail closed rather than duplicate work.
.         if `caseno' == 1 {
 36.             mkdir `"`jobdir'/job_1.lock"'
 37.             capture noisily jwselect_worker using `"`jobdir'"', worker(1) workers(1)
 38.             assert _rc != 0
 39.             capture noisily jwselect_collect using `"`jobdir'"'
 40.             assert _rc != 0
 41.             rmdir `"`jobdir'/job_1.lock"'
 42.             // A later acquisition failure releases only our earlier lock.
.             mkdir `"`jobdir'/job_2.lock"'
 43.             capture noisily jwselect_worker using `"`jobdir'"', worker(1) workers(1) jobids(1 2)
 44.             assert _rc==603
 45.             mata: assert(!direxists(st_local("jobdir")+"/job_1.lock"))
 46.             mata: assert(direxists(st_local("jobdir")+"/job_2.lock"))
 47.             rmdir `"`jobdir'/job_2.lock"'
 48.             // Missing READY means incomplete preparation: no worker may proceed.
.             copy `"`jobdir'/READY.dta"' `"`jobdir'/READY_test_backup.dta"'
 49.             erase `"`jobdir'/READY.dta"'
 50.             capture noisily jwselect_worker using `"`jobdir'"', worker(1) workers(1)
 51.             assert _rc != 0
 52.             copy `"`jobdir'/READY_test_backup.dta"' `"`jobdir'/READY.dta"'
 53.             erase `"`jobdir'/READY_test_backup.dta"'
 54.             // Verify frozen-code integrity before allowing any numerical work.
.             copy `"`jobdir'/code/_jwselect_mata.do"' `"`jobdir'/code/test_original.do"'
 55.             tempname corrupt
 56.             file open `corrupt' using `"`jobdir'/code/_jwselect_mata.do"', write append text
 57.             file write `corrupt' _n "// deliberate test-only checksum mismatch" _n
 58.             file close `corrupt'
 59.             capture noisily jwselect_worker using `"`jobdir'"', worker(1) workers(1)
 60.             assert _rc != 0
 61.             copy `"`jobdir'/code/test_original.do"' `"`jobdir'/code/_jwselect_mata.do"', replace
 62.             erase `"`jobdir'/code/test_original.do"'
 63.             // A crashed, unmarked partial result must be replaced safely.
.             tempname partial
 64.             file open `partial' using `"`jobdir'/job_1.bin"', write binary
 65.             file close `partial'
 66.             // jobids intersects all other filters and the GLOBAL shard index.
.             // Of IDs 1/2/3, only 2 is output1/objective1/start2 and in shard2.
.             jwselect_worker using `"`jobdir'"', worker(2) workers(2) ///
>                 jobids(1 2 3) outputs(1) objectives(1) starts(2) cachemb(.002)
 67.             assert r(assigned)==1
 68.             assert r(lock_failures)==0
 69.             confirm file `"`jobdir'/job_2.bin.done"'
 70.             capture confirm file `"`jobdir'/job_1.bin.done"'
 71.             assert _rc != 0
 72.             capture confirm file `"`jobdir'/job_3.bin.done"'
 73.             assert _rc != 0
 74.             // Repeating an explicit completed ID is an idempotent restart.
.             jwselect_worker using `"`jobdir'"', worker(1) workers(1) jobids(2) cachemb(0)
 75.             assert r(assigned)==1
 76.             capture noisily jwselect_worker using `"`jobdir'"', worker(1) workers(1) jobids(0)
 77.             assert _rc != 0
 78.             assert `"`c(rngstate)'"' == `"`old_rng'"'
 79.         }
 80. 
.         // Exercise objective filters, then out-of-order sharding and restart.
.         jwselect_worker using `"`jobdir'"', worker(1) workers(1) objectives(1) cachemb(0)
 81.         capture noisily jwselect_collect using `"`jobdir'"'
 82.         assert _rc != 0
 83.         forvalues worker=4(-1)1 {
 84.             jwselect_worker using `"`jobdir'"', worker(`worker') workers(4) cachemb(64)
 85.             assert r(lock_failures)==0
 86.             assert `"`c(rngstate)'"' == `"`old_rng'"'
 87.         }
 88.         // Repeating completed assignments must safely skip completed jobs.
.         jwselect_worker using `"`jobdir'"', worker(1) workers(1) cachemb(0)
 89.         if `caseno' == 1 {
 90.             // A marked result from the wrong job must never be merged silently.
.             copy `"`jobdir'/job_2.bin"' `"`jobdir'/job_2_test_original.bin"'
 91.             copy `"`jobdir'/job_1.bin"' `"`jobdir'/job_2.bin"', replace
 92.             // A result-validation error must keep its rc and release our lock.
.             capture noisily jwselect_worker using `"`jobdir'"', worker(1) workers(1) jobids(2)
 93.             assert _rc==3498
 94.             mata: assert(!direxists(st_local("jobdir")+"/job_2.lock"))
 95.             assert `"`c(rngstate)'"' == `"`old_rng'"'
 96.             capture noisily jwselect_collect using `"`jobdir'"'
 97.             assert _rc != 0
 98.             copy `"`jobdir'/job_2_test_original.bin"' `"`jobdir'/job_2.bin"', replace
 99.             erase `"`jobdir'/job_2_test_original.bin"'
100.         }
101.         jwselect_collect using `"`jobdir'"'
102.         assert r(N_jobs)>0
103.         matrix JW030_COLLECT = r(table)
104.         matrix JW030_CDIAG = r(diagnostics)
105.         matrix JW030_CEXT = r(extrema)
106.         matrix JW030_CMAP = r(output_map)
107.         matrix JW030_JOBS = r(jobs)
108.         mata: jw030_equal("JW030_COLLECT","JW030_SERIAL",1e-10)
109.         mata: jw030_equal("JW030_CDIAG","JW030_DIAG",1e-10)
110.         mata: jw030_equal("JW030_CEXT","JW030_EXT",1e-10)
111.         mata: jw030_equal("JW030_CMAP","JW030_MAP",1e-10)
112.         mata: assert(cols(st_matrix("JW030_JOBS"))==4)
113.         mata: assert(rows(st_matrix("JW030_JOBS"))==8*rows(st_matrix("JW030_MAP")))
114.         // Worker/collector are rclass; preparation's posted estimates survive.
.         mata: jw030_equal("e(b)","JW030_PREP_B",1e-10)
115.         assert `"`c(rngstate)'"' == `"`old_rng'"'
116.     }
