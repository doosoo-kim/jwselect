>         if (sum(M.groups:==F.owners[i])!=1) jw_core_error("candidate owner is not a unique model cohort")
>         if (M.k>0) {
>             if (sum(F.masks[i,.]:*(M.hmap[.,1]':!=F.owners[i]))>0) {
