>     localmasks = J(G,M.k,0)
>     chosenunion = J(1,M.k,0)
>     aggregatetarget = (M.w,J(1,M.k,0))
>     isfocused = selectstr=="focused"
>     docohort = isfocused & (focusstr=="cohort" | focusstr=="both")
