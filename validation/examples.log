: 
: real scalar jw_findcell(real matrix cells, real scalar g, real scalar t,
>                         real scalar gap)
> {
>     real colvector ix
>     ix = vec(selectindex((cells[,1] :== g) :&
>                      (abs(cells[,2] :- t) :<= 1e-8*gap)))
>     if (rows(ix)==0) return(0)
>     if (rows(ix)>1) jw_design_error("duplicate cohort-time cells")
>     return(ix[1])
> }

