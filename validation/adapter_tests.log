. 
. clear

. set seed 681914

. set obs 3600
Number of observations (_N) was 0, now 3,600.

. generate long id = ceil(_n/6)

. generate byte time = mod(_n-1,6)+1

. generate byte group = cond(mod(id,3)==0,0,cond(mod(id,3)==1,3,5))

. generate double x = sin(id/8)

. generate double eta = -.8+.12*time+.15*x+.2*(group==3) ///
>     +.3*(group>0 & time>=group)+.12*x*(group>0 & time>=group)

. generate byte binary = runiform()<invlogit(eta)

. generate double count = rpoisson(exp(eta+.5))

. generate double original_order = runiform()

. sort original_order

. 
. foreach link in logit poisson {
  2.     local y binary
  3.     if "`link'"=="poisson" local y count
  4.     quietly jwdid `y' x, ivar(id) tvar(time) gvar(group) never ///
>         method(`link') cluster(id)
  5.     assert `"`e(cmd2)'"'=="`link'"
  6.     assert e(converged)==1
  7.     tempname source sourceb sourceV rawb rawV rawC condB condV
  8.     quietly estimates store `source'
  9.     matrix `sourceb'=e(b)
 10.     matrix `sourceV'=e(V)
 11.     local sourcecmd `"`e(cmdline)'"'
 12. 
.     capture drop __attgt__
 13.     capture label drop __attgt__
 14.     generate byte __attgt__=99
 15.     label define __attgt__ 99 "nonlinear restoration sentinel"
 16.     label values __attgt__ __attgt__
 17.     capture drop original_esample
 18.     generate byte original_esample=e(sample)
 19.     quietly datasignature
 20.     local signature `"`r(datasignature)'"'
 21.     quietly ds
 22.     local signature_vars `"`r(varlist)'"'
 23.     // estimates restore can recreate/reorder Stata's own _est_* sample
.     // storage. Use the same explicit variable order for the complete-exercise
.     // check; the immediate adapter check below also checks variable order.
.     quietly _datasignature `signature_vars'
 24.     local ordered_signature `"`r(datasignature)'"'
 25.     local before_rng `c(rngstate)'
 26. 
.     quietly _jwselect_jwdid, vce(unconditional)
 27.     matrix `rawb'=r(bgt)
 28.     matrix `rawV'=r(Vgt)
 29.     matrix `rawC'=r(cells)
 30.     assert `"`r(model)'"'=="nonlinear"
 31.     assert `"`r(method)'"'=="`link'"
 32.     assert `"`r(restriction_scale)'"'=="outcome_placebo"
 33.     assert r(N_units)==600 & r(N_obs)==3600 & r(N_clusters)==600
 34.     assert r(N_covariates)==1 & r(gap)==1 & r(anticipation)==1
 35.     assert `"`e(cmd)'"'=="jwdid"
 36.     assert `"`e(cmdline)'"'==`"`sourcecmd'"'
 37.     assert e(sample)==original_esample
 38.     mata: assert(max(abs(st_matrix("e(b)")-st_matrix("`sourceb'")))==0)
 39.     mata: assert(max(abs(st_matrix("e(V)")-st_matrix("`sourceV'")))==0)
 40.     quietly datasignature
 41.     assert `"`r(datasignature)'"'==`"`signature'"'
 42.     local label : label __attgt__ 99
 43.     assert `"`label'"'=="nonlinear restoration sentinel"
 44.     assert `"`c(rngstate)'"'==`"`before_rng'"'
 45. 
.     // Compare the complete joint covariance, including pre/post and cross-
.     // cohort entries, with the upstream one-call outcome-scale margins.
.     preserve
 46.     quietly estat attgt, vce(unconditional)
 47.     assert `"`r(agg)'"'=="attgt"
 48.     matrix JW_NL_DIRECT_B=r(b)
 49.     matrix JW_NL_DIRECT_V=r(V)
 50.     restore
 51.     quietly estimates restore `source'
 52.     mata: assert(max(abs(st_matrix("JW_NL_DIRECT_B")-st_matrix("`rawb'")))<1e-9)
 53.     mata: assert(max(abs(st_matrix("JW_NL_DIRECT_V")-st_matrix("`rawV'")))<1e-9)
 54. 
.     quietly _jwselect_jwdid, vce(conditional)
 55.     matrix `condB'=r(bgt)
 56.     matrix `condV'=r(Vgt)
 57.     mata: assert(max(abs(st_matrix("`condB'")-st_matrix("`rawb'")))<1e-9)
 58.     preserve
 59.     quietly estat attgt
 60.     matrix JW_NL_COND_V=r(V)
 61.     restore
 62.     quietly estimates restore `source'
 63.     mata: assert(max(abs(st_matrix("JW_NL_COND_V")-st_matrix("`condV'")))<1e-9)
 64. 
.     // Independent point-estimate check: predict both linear indices, apply
.     // the appropriate inverse link, and average the individual contrasts.
.     preserve
 65.     quietly _jwselect_nl_metadata, cmd(`link')
 66.     quietly replace __tr__=1
 67.     quietly predict double nl_xb1, xb
 68.     quietly replace __tr__=0
 69.     quietly predict double nl_xb0, xb
 70.     if "`link'"=="logit" generate double nl_effect=invlogit(nl_xb1)-invlogit(nl_xb0)
 71.     else generate double nl_effect=exp(nl_xb1)-exp(nl_xb0)
 72.     forvalues j=1/`=rowsof(`rawC')' {
 73.         local g=`rawC'[`j',1]
 74.         local t=`rawC'[`j',2]
 75.         quietly summarize nl_effect if group==`g' & time==`t', meanonly
 76.         assert abs(r(mean)-`rawb'[1,`j'])<1e-8
 77.     }
 78.     restore
 79.     quietly estimates restore `source'
 80. 
.     // Construct the canonical target/placebo vector independently. All
.     // included baseline margins must already be structural zeros.
.     mata: _jwselect_nl_canonical("`rawb'", "`rawV'", "`rawC'")
 81. 
.     quietly jwselect, select(manual) postwindow(0 1)
 82.     assert e(K)==4 & e(P)==4 & e(G)==2
 83.     mata: assert(max(abs(st_matrix("e(z)")-st_matrix("JW_NL_Z")))<1e-9)
 84.     mata: assert(max(abs(st_matrix("e(V_z)")-st_matrix("JW_NL_ZV")))<1e-9)
 85.     mata: assert(max(abs(st_matrix("e(b)")-st_matrix("JW_NL_EXPECTED_B")))<1e-9)
 86.     mata: assert(max(abs(st_matrix("e(V)")-st_matrix("JW_NL_EXPECTED_V")))<1e-9)
 87.     assert e(sample)==original_esample
 88. 
.     // An all-moment manual adjustment agrees with the direct covariance
.     // projection; this is a moment adjustment, not a nonlinear model refit.
.     quietly estimates restore `source'
 89.     matrix JW_NL_PRE=(3,1\5,1\5,2\5,3)
 90.     quietly jwselect, select(manual) prematrix(JW_NL_PRE) postwindow(0 1)
 91.     mata: _jwselect_nl_projection()
 92.     quietly estat pretrend
 93.     assert r(df)==4
 94. 
.     quietly estimates restore `source'
 95.     quietly jwselect, select(wbic) wbicscope(joint) candidates(all) postwindow(0 1)
 96.     assert `"`e(cmd)'"'=="jwselect"
 97.     mata: assert(!hasmissing(st_matrix("e(b)")))
 98. 
.     // Incompatible rebasing is refused by the public adapter dispatch.
.     quietly estimates restore `source'
 99.     capture noisily jwselect, baseline(common) select(manual) postwindow(0 1)
100.     assert _rc==198
101.     assert `"`e(cmd)'"'=="jwdid" & `"`e(cmd2)'"'=="`link'"
102.     capture noisily jwselect, anticipation(1) select(manual) postwindow(0 1)
103.     assert _rc==198
104.     assert `"`e(cmd)'"'=="jwdid" & `"`e(cmd2)'"'=="`link'"
105. 
.     // Failed validation preserves the data and source results.
.     quietly _jwselect_nl_metadata, converged(0)
106.     capture noisily _jwselect_jwdid
107.     assert _rc==498
108.     assert e(converged)==0 & `"`e(cmd)'"'=="jwdid"
109.     quietly estimates restore `source'
110.     quietly _jwselect_nl_metadata, method(ppmlhdfe)
111.     capture noisily _jwselect_jwdid
112.     assert _rc==198
113.     assert `"`e(cmd2)'"'=="ppmlhdfe"
114.     quietly estimates restore `source'
115.     quietly _jwselect_nl_metadata, index(index)
116.     capture noisily _jwselect_jwdid
117.     assert _rc==198
118.     assert `"`e(index)'"'=="index"
119.     quietly estimates restore `source'
120.     quietly ds
121.     local current_vars `"`r(varlist)'"'
122.     local extra_vars : list current_vars - signature_vars
123.     local lost_vars : list signature_vars - current_vars
124.     assert `"`extra_vars'`lost_vars'"'==""
125.     quietly _datasignature `signature_vars'
126.     local final_signature `"`r(datasignature)'"'
127.     if `"`final_signature'"'!=`"`ordered_signature'"' {
128.         display as error "Nonlinear integration data-restoration check failed (`link')"
129.         display as error `"Before: `ordered_signature'"'
130.         display as error `"After:  `final_signature'"'
131.         display as error `"Original variables: `signature_vars'"'
132.         quietly ds
133.         display as error `"Current variables:  `r(varlist)'"'
134.     }
135.     assert `"`final_signature'"'==`"`ordered_signature'"'
136.     quietly estimates drop `source'
137.     display as result "jwselect nonlinear `link' integration: PASS"
138. }
