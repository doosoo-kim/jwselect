. preserve

. quietly estat attgt, vce(unconditional)

. assert `"`r(agg)'"' == "attgt"

. matrix JW_UP_DIRECT_B = r(b)

. matrix JW_UP_DIRECT_V = r(V)

. restore

. mata: assert(max(abs(st_matrix("JW_UP_DIRECT_B")-st_matrix("`rawb'"))) < 1e-8)

