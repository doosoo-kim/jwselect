. matrix `conditionalb' = r(bgt)

. matrix `conditionalV' = r(Vgt)

. assert `"`r(vce)'"' == "conditional"

. mata: assert(max(abs(st_matrix("`conditionalb'")-st_matrix("`rawb'"))) < 1e-8)

