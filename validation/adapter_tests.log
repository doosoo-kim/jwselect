. capture program drop _jw_cs_fixture

. program define _jw_cs_fixture, eclass
  1.     version 16.1
  2.     syntax [, PERMuted ANTI(integer 0)]
  3.     tempname B V A
  4.     tempvar sample
  5.     quietly generate byte `sample' = 1
  6.     mata: jw_csf_fixture("`B'", "`V'", "`A'", `anti', "`permuted'"!="")
  7.     matrix colnames `A' = group time event_time att se n_treat_t n_treat_pre n_control_t n_control_pre base_time
  8.     ereturn post `B' `V', esample(`sample') obs(480)
  9.     ereturn matrix attgt = `A'
 10.     ereturn local cmdline "csdid y x, ivar(id) time(time) gvar(group) method(dr) nevertreated base_period(universal) analytical pointwi
> se anticipation(`anti')"
 11.     ereturn local version "2.0.1"
 12.     ereturn local method "dr"
 13.     ereturn local control_group "nevertreated"
 14.     ereturn local base_period "universal"
 15.     ereturn local panel_mode "panel"
 16.     ereturn local idvar "id"
 17.     ereturn local timevar "time"
 18.     ereturn local gvar "group"
 19.     ereturn local depvar "y"
 20.     ereturn local vce "analytical"
 21.     ereturn scalar bstrap = 0
 22.     ereturn scalar N_units = 60
 23.     ereturn scalar N_time = 8
 24.     ereturn scalar N_groups = 2
 25.     ereturn scalar anticipation = `anti'
 26.     ereturn scalar pscoretrim = .995
 27.     ereturn scalar level = 95
 28.     quietly signestimationsample id time group y x
 29.     ereturn local cmd "csdid"
 30. end

