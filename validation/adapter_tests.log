. program define _jw_cs_badtable, eclass
  1.     args bad
  2.     tempname A
  3.     matrix `A' = e(attgt)
  4.     if "`bad'" == "normalization" matrix `A'[3,4] = .1
  5.     if "`bad'" == "duplicate" matrix `A'[2,1] = 4
  6.     if "`bad'" == "duplicate" matrix `A'[2,2] = 1
  7.     if "`bad'" == "duplicate" matrix `A'[2,3] = -3
  8.     if "`bad'" == "missing" matrix `A'[1,4] = .
  9.     if "`bad'" == "se" matrix `A'[1,5] = 0
 10.     if "`bad'" == "base" matrix `A'[1,10] = 2
 11.     ereturn matrix attgt = `A'
 12. end

