. assert _rc==198

. assert "`e(cmd)'"=="csdid"

. capture noisily jwselect, anticipation(1)
anticipation() must match the source estimator's maintained baseline (0)

. assert _rc==198

. assert "`e(cmd)'"=="csdid"

. 
