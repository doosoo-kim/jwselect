*! jwselect 0.4.0 public joint selection/test regression checks.
*! Run from the extracted package root: do tests/joint040_smoke.do
*! Does not clear, replace, or alter the active dataset.
version 16.1
set more off
adopath ++ "."
local j40_N = _N
local j40_k = c(k)
local j40_rng `c(rngstate)'
if `j40_k' > 0 {
    quietly datasignature
    local j40_data `"`r(datasignature)'"'
}
do tests/joint040_fixture.do

// Correlated cohorts: the joint objective must differ from separate selection.
jwselect, bmat(J40_B) vmat(J40_V) cells(J40_C) nunits(100) ///
    select(wbic) candidates(all)
assert "`e(wbic_scope)'" == "cohort"
mata: assert(max(abs(st_matrix("e(selection)"))) == 0)
mata: assert(max(abs(st_matrix("e(b)")-st_matrix("J40_CB"))) < 1e-11)
matrix J40_DEFAULT_B = e(b)
matrix J40_DEFAULT_V = e(V)
jwselect, bmat(J40_B) vmat(J40_V) cells(J40_C) nunits(100) ///
    select(wbic) wbicscope(cohort) candidates(all)
mata: assert(max(abs(st_matrix("e(b)")-st_matrix("J40_DEFAULT_B"))) < 1e-13)
mata: assert(max(abs(st_matrix("e(V)")-st_matrix("J40_DEFAULT_V"))) < 1e-13)

jwselect, bmat(J40_B) vmat(J40_V) cells(J40_C) nunits(100) ///
    select(wbic) wbicscope(joint) candidates(all) maxjoint(4)
assert "`e(wbic_scope)'" == "joint"
assert has_eprop("V")
mata: assert(max(abs(st_matrix("e(z)")-st_matrix("J40_Z"))) < 1e-13)
mata: assert(max(abs(st_matrix("e(V_z)")-st_matrix("J40_VZ"))) < 1e-13)
mata: assert(max(abs(st_matrix("e(selection)"):-1)) == 0)
mata: assert(max(abs(st_matrix("e(joint_candidates)")-st_matrix("J40_FAMILY"))) == 0)
mata: assert(max(abs(st_matrix("e(b)")-st_matrix("J40_JB"))) < 1e-11)
mata: assert(max(abs(st_matrix("e(V)")-st_matrix("J40_JV"))) < 1e-11)
mata: assert(max(abs(st_matrix("e(loading)")-st_matrix("J40_JA"))) < 1e-11)
mata: J40_s = st_matrix("e(scores)")
mata: J40_j = select(J40_s,J40_s[,1]:==2)
mata: assert(rows(J40_j)==4)
mata: assert(max(abs(J40_j[,4..11]-st_matrix("J40_JSTATS"))) < 1e-10)

// Default pretrend test uses every eligible restriction jointly. J40_ALLTEST
// was generated by a full covariance-weighted MD residual objective, independently of Wald.
matrix J40_BEFORE_B = e(b)
matrix J40_BEFORE_V = e(V)
matrix J40_BEFORE_S = e(selection)
matrix J40_BEFORE_SC = e(scores)
local j40_cmd `e(cmd)'
local j40_scope `e(wbic_scope)'
local j40_post_rng `c(rngstate)'
estat pretrend
assert r(df) == 2
assert "`r(test_set)'" == "all"
assert r(postselection) == 0
assert abs(r(chi2)-125/19) < 1e-11
assert abs(r(J)-125/19) < 1e-11
assert abs(r(chi2)-12.5) > 5
mata: assert(max(abs(st_matrix("r(table)")-st_matrix("J40_ALLTEST"))) < 1e-11)
mata: assert(max(abs(st_matrix("r(mask)"):-1)) == 0)
matrix J40_TESTTABLE = r(table)
local j40_cols : colnames J40_TESTTABLE
assert "`j40_cols'" == "df Wald J pvalue"
assert "`e(cmd)'" == "`j40_cmd'"
assert "`e(wbic_scope)'" == "`j40_scope'"
mata: assert(max(abs(st_matrix("e(b)")-st_matrix("J40_BEFORE_B"))) == 0)
mata: assert(max(abs(st_matrix("e(V)")-st_matrix("J40_BEFORE_V"))) == 0)
mata: assert(max(abs(st_matrix("e(selection)")-st_matrix("J40_BEFORE_S"))) == 0)
mata: assert(max(abs(st_matrix("e(scores)")-st_matrix("J40_BEFORE_SC"))) == 0)
assert `"`c(rngstate)'"' == `"`j40_post_rng'"'
estat pretrend, selected
assert "`r(test_set)'" == "selected"
assert r(postselection) == 1
assert r(df) == 2
mata: assert(max(abs(st_matrix("r(table)")-st_matrix("J40_ALLTEST"))) < 1e-11)
estat pretrend, selected output(3)
assert r(output) == 3
assert r(df) == 2

// A prespecified restriction list tests exactly those dates against the fitted
// baseline, without rerunning selection or modifying the estimates.
estat pretrend, prematrix(J40_PRE)
assert "`r(test_set)'" == "custom"
assert r(postselection) == 0
assert r(df) == 1
mata: assert(max(abs(st_matrix("r(table)")-st_matrix("J40_ONETEST"))) < 1e-11)
mata: assert(max(abs(st_matrix("r(mask)")-(1,0))) == 0)
mata: assert(max(abs(st_matrix("r(preperiods)")-st_matrix("J40_PRE"))) == 0)
mata: assert(max(abs(st_matrix("e(b)")-st_matrix("J40_BEFORE_B"))) == 0)

// Invalid options and malformed/ineligible restrictions must not change e().
capture noisily estat pretrend, selected prematrix(J40_PRE)
assert _rc != 0
capture noisily estat pretrend, output(1)
assert _rc != 0
capture noisily estat pretrend, output(0)
assert _rc != 0
capture noisily estat pretrend, selected output(0)
assert _rc != 0
capture noisily estat pretrend, selected output(4)
assert _rc != 0
matrix J40_BADPRE = (3,2)
capture noisily estat pretrend, prematrix(J40_BADPRE)
assert _rc != 0
matrix J40_BADPRE = (3,1 \ 3,1)
capture noisily estat pretrend, prematrix(J40_BADPRE)
assert _rc != 0
matrix J40_BADPRE = (3,.)
capture noisily estat pretrend, prematrix(J40_BADPRE)
assert _rc != 0
matrix J40_BADPRE = (3,1,0)
capture noisily estat pretrend, prematrix(J40_BADPRE)
assert _rc != 0
mata: assert(max(abs(st_matrix("e(b)")-st_matrix("J40_BEFORE_B"))) == 0)
mata: assert(max(abs(st_matrix("e(V)")-st_matrix("J40_BEFORE_V"))) == 0)
assert `"`c(rngstate)'"' == `"`j40_post_rng'"'

// Search limits are hard errors, not silent truncation or local fallback.
capture noisily jwselect, bmat(J40_B) vmat(J40_V) cells(J40_C) nunits(100) ///
    select(wbic) wbicscope(joint) candidates(all) maxjoint(3)
assert _rc != 0
mata: assert(max(abs(st_matrix("e(b)")-st_matrix("J40_BEFORE_B"))) == 0)
capture noisily jwselect, bmat(J40_B) vmat(J40_V) cells(J40_C) nunits(100) ///
    select(wbic) wbicscope(joint) candidates(all) maxcand(1)
assert _rc != 0
matrix J40_CUSTOM = (1,0 \ 1,1 \ 0,0 \ 1,1)
jwselect, bmat(J40_B) vmat(J40_V) cells(J40_C) nunits(100) ///
    select(wbic) wbicscope(joint) jointmatrix(J40_CUSTOM) maxjoint(3)
mata: assert(max(abs(st_matrix("e(joint_candidates)")-(1,0\1,1\0,0))) == 0)
mata: assert(max(abs(st_matrix("e(b)")-st_matrix("J40_JB"))) < 1e-11)
matrix J40_CUSTOM = (1,0)
jwselect, bmat(J40_B) vmat(J40_V) cells(J40_C) nunits(100) ///
    select(wbic) wbicscope(joint) jointmatrix(J40_CUSTOM) maxjoint(2)
mata: assert(max(abs(st_matrix("e(joint_candidates)")-(0,0\1,0))) == 0)
mata: assert(max(abs(st_matrix("e(selection)"))) == 0)
capture noisily jwselect, bmat(J40_B) vmat(J40_V) cells(J40_C) nunits(100) ///
    select(wbic) wbicscope(joint) jointmatrix(J40_CUSTOM) maxjoint(1)
assert _rc != 0

// Without jointmatrix(), the joint family respects each custom local family.
matrix J40_LOCAL_CUSTOM = (3,0,0 \ 4,0,1)
jwselect, bmat(J40_B) vmat(J40_V) cells(J40_C) nunits(100) ///
    select(wbic) wbicscope(joint) candmatrix(J40_LOCAL_CUSTOM) maxjoint(2)
mata: assert(max(abs(st_matrix("e(joint_candidates)")-(0,0\0,1))) == 0)
mata: assert(max(abs(st_matrix("e(selection)"))) == 0)

// Joint WBIC is a restriction criterion, independent of the aggregate target.
matrix J40_WEIGHTS = (3,3,.9 \ 4,4,.1)
jwselect, bmat(J40_B) vmat(J40_V) cells(J40_C) nunits(100) ///
    select(wbic) wbicscope(joint) aggweights(J40_WEIGHTS)
mata: assert(max(abs(st_matrix("e(selection)"):-1)) == 0)
mata: J40_s = st_matrix("e(scores)")
mata: J40_j = select(J40_s,J40_s[,1]:==2)
mata: assert(max(abs(J40_j[,5..6]-st_matrix("J40_JSTATS")[,2..3])) < 1e-11)
matrix J40_WEIGHTS = (3,3,.1 \ 4,4,.9)
jwselect, bmat(J40_B) vmat(J40_V) cells(J40_C) nunits(100) ///
    select(wbic) wbicscope(joint) aggweights(J40_WEIGHTS)
mata: assert(max(abs(st_matrix("e(selection)"):-1)) == 0)
mata: J40_s = st_matrix("e(scores)")
mata: J40_j = select(J40_s,J40_s[,1]:==2)
mata: assert(max(abs(J40_j[,5..6]-st_matrix("J40_JSTATS")[,2..3])) < 1e-11)

// Block-diagonal covariance gives the same nonempty selected set in both scopes.
jwselect, bmat(J40_BLOCK_B) vmat(J40_BLOCK_V) cells(J40_C) nunits(100) ///
    select(wbic) wbicscope(cohort) candidates(all)
matrix J40_BLOCK_LOCAL_B = e(b)
matrix J40_BLOCK_LOCAL_V = e(V)
matrix J40_BLOCK_LOCAL_S = e(selection)
jwselect, bmat(J40_BLOCK_B) vmat(J40_BLOCK_V) cells(J40_C) nunits(100) ///
    select(wbic) wbicscope(joint) candidates(all)
mata: assert(max(abs(st_matrix("e(b)")-st_matrix("J40_BLOCK_EST"))) < 1e-11)
mata: assert(max(abs(st_matrix("e(V)")-st_matrix("J40_BLOCK_VCOV"))) < 1e-11)
mata: assert(max(abs(st_matrix("e(b)")-st_matrix("J40_BLOCK_LOCAL_B"))) < 1e-11)
mata: assert(max(abs(st_matrix("e(V)")-st_matrix("J40_BLOCK_LOCAL_V"))) < 1e-11)
mata: assert(max(abs(st_matrix("e(selection)")-st_matrix("J40_BLOCK_LOCAL_S"))) == 0)
mata: assert(max(abs(st_matrix("e(selection)")-J(3,1,1)*st_matrix("J40_BLOCK_MASK"))) == 0)

// Exact singleton ties preserve first occurrence after duplicate coalescing.
matrix J40_TIES = (1,0 \ 0,1 \ 1,0)
jwselect, bmat(J40_TIE_B) vmat(J40_TIE_V) cells(J40_C) nunits(100) ///
    select(wbic) wbicscope(joint) jointmatrix(J40_TIES) maxjoint(3)
mata: assert(max(abs(st_matrix("e(selection)")-J(3,1,1)*(1,0))) == 0)
matrix J40_TIES = (0,1 \ 1,0 \ 0,1)
jwselect, bmat(J40_TIE_B) vmat(J40_TIE_V) cells(J40_C) nunits(100) ///
    select(wbic) wbicscope(joint) jointmatrix(J40_TIES) maxjoint(3)
mata: assert(max(abs(st_matrix("e(selection)")-J(3,1,1)*(0,1))) == 0)

// A single cohort has identical candidate families and estimates across scopes.
jwselect, bmat(J40_ONE_B) vmat(J40_ONE_V) cells(J40_ONE_C) nunits(100) ///
    select(wbic) wbicscope(cohort)
matrix J40_SINGLE_B = e(b)
matrix J40_SINGLE_V = e(V)
matrix J40_SINGLE_S = e(selection)
jwselect, bmat(J40_ONE_B) vmat(J40_ONE_V) cells(J40_ONE_C) nunits(100) ///
    select(wbic) wbicscope(joint)
mata: assert(max(abs(st_matrix("e(b)")-st_matrix("J40_SINGLE_B"))) < 1e-11)
mata: assert(max(abs(st_matrix("e(V)")-st_matrix("J40_SINGLE_V"))) < 1e-11)
mata: assert(max(abs(st_matrix("e(selection)")-st_matrix("J40_SINGLE_S"))) == 0)
estat pretrend, selected
assert r(df) == 0
assert r(chi2) == 0
assert r(J) == 0
assert missing(r(p))

// Scalar preperiod maps still reject unknown dates/cohorts and baselines.
matrix J40_BADPRE = (3,100)
capture noisily estat pretrend, prematrix(J40_BADPRE)
assert _rc != 0
matrix J40_BADPRE = (99,1)
capture noisily estat pretrend, prematrix(J40_BADPRE)
assert _rc != 0
matrix J40_BADPRE = (3,2)
capture noisily estat pretrend, prematrix(J40_BADPRE)
assert _rc != 0
estat pretrend, prematrix(J40_PRE)
assert r(df) == 1
assert abs(r(chi2)-6.25) < 1e-11

// Calendar lookup uses the same tolerance as manual selection for decimal gaps.
matrix J40_DECIMAL_C = (.3,.1 \ .3,.2 \ .3,.3 \ .4,.2 \ .4,.3 \ .4,.4)
matrix J40_DECIMAL_PRE = (.3,.1000000001)
jwselect, bmat(J40_B) vmat(J40_V) cells(J40_DECIMAL_C) nunits(100) ///
    gap(.1) select(manual) prematrix(J40_DECIMAL_PRE)
estat pretrend, prematrix(J40_DECIMAL_PRE)
assert r(df) == 1
assert abs(r(chi2)-6.25) < 1e-11
mata: assert(max(abs(st_matrix("r(mask)")-(1,0))) == 0)

// Focused estimation has output-specific selections: an output is mandatory.
jwselect, bmat(J40_B) vmat(J40_V) cells(J40_C) nunits(100) ///
    select(focused) focus(both) candidates(all) inference(none)
assert colsof(e(b)) == 4
matrix J40_FOCUSED_B = e(b)
matrix J40_FOCUSED_S = e(selection)
capture noisily estat pretrend, selected
assert _rc != 0
forvalues j40_o = 1/4 {
    estat pretrend, selected output(`j40_o')
    assert r(output) == `j40_o'
    assert "`r(test_set)'" == "selected"
    assert r(postselection) == 1
    mata: assert(max(abs(st_matrix("r(mask)")-st_matrix("J40_FOCUSED_S")[`j40_o',.])) == 0)
    assert abs(r(chi2)-r(J)) < 1e-10
}
mata: assert(max(abs(st_matrix("e(b)")-st_matrix("J40_FOCUSED_B"))) == 0)
estat pretrend
assert r(df) == 2
mata: assert(max(abs(st_matrix("r(table)")-st_matrix("J40_ALLTEST"))) < 1e-11)

// Mis-scoped joint options and malformed masks must fail explicitly.
capture noisily jwselect, bmat(J40_B) vmat(J40_V) cells(J40_C) nunits(100) ///
    select(wbic) jointmatrix(J40_CUSTOM)
assert _rc != 0
capture noisily jwselect, bmat(J40_B) vmat(J40_V) cells(J40_C) nunits(100) ///
    select(focused) wbicscope(joint) inference(none)
assert _rc != 0
capture noisily jwselect, bmat(J40_B) vmat(J40_V) cells(J40_C) nunits(100) ///
    select(manual) wbicscope(cohort)
assert _rc != 0
capture noisily jwselect, bmat(J40_B) vmat(J40_V) cells(J40_C) nunits(100) ///
    select(wbic) wbicscope(invalid)
assert _rc != 0
matrix J40_BADMASK = (1,.5)
capture noisily jwselect, bmat(J40_B) vmat(J40_V) cells(J40_C) nunits(100) ///
    select(wbic) wbicscope(joint) jointmatrix(J40_BADMASK)
assert _rc != 0
matrix J40_BADMASK = (1,.)
capture noisily jwselect, bmat(J40_B) vmat(J40_V) cells(J40_C) nunits(100) ///
    select(wbic) wbicscope(joint) jointmatrix(J40_BADMASK)
assert _rc != 0
matrix J40_BADMASK = (1)
capture noisily jwselect, bmat(J40_B) vmat(J40_V) cells(J40_C) nunits(100) ///
    select(wbic) wbicscope(joint) jointmatrix(J40_BADMASK)
assert _rc != 0

// A valid PSD input can have a singular joint restriction covariance. An
// unrestricted manual fit remains available; testing must reject that joint Q,
// while a positive-variance singleton subset remains testable.
jwselect, bmat(J40_B) vmat(J40_SINGULAR_V) cells(J40_C) nunits(100) select(manual)
matrix J40_SINGULAR_B = e(b)
capture noisily estat pretrend
assert _rc != 0
mata: assert(max(abs(st_matrix("e(b)")-st_matrix("J40_SINGULAR_B"))) == 0)
estat pretrend, prematrix(J40_PRE)
assert r(df) == 1
assert abs(r(chi2)-6.25) < 1e-11
assert abs(r(J)-6.25) < 1e-11

// No eligible optional preperiods: one empty model, no zero-width Stata matrix.
matrix J40_ZERO_B = (0,.5,0,1)
matrix J40_ZERO_V = (0,0,0,0 \ 0,.04,0,0 \ 0,0,0,0 \ 0,0,0,.09)
matrix J40_ZERO_C = (3,2 \ 3,3 \ 4,3 \ 4,4)
jwselect, bmat(J40_ZERO_B) vmat(J40_ZERO_V) cells(J40_ZERO_C) nunits(100) ///
    select(wbic) wbicscope(joint) maxjoint(1)
assert e(K) == 0
assert "`e(wbic_scope)'" == "joint"
estat pretrend
assert r(df) == 0
assert r(chi2) == 0
assert r(J) == 0
assert missing(r(p))
assert "`r(test_set)'" == "all"
assert rowsof(r(table)) == 1
assert colsof(r(table)) == 4
// An absent r(name) evaluates to scalar missing, so matrix A=r(name)
// can succeed even when no matrix was returned. Inspect matrix names instead.
return list
local j40_rmatrices : r(matrices)
assert strpos(" `j40_rmatrices' ", " table ") > 0
assert strpos(" `j40_rmatrices' ", " mask ") == 0
assert strpos(" `j40_rmatrices' ", " preperiods ") == 0
estat pretrend, selected
assert r(df) == 0
assert r(J) == 0
assert r(postselection) == 1
local j40_rmatrices : r(matrices)
assert strpos(" `j40_rmatrices' ", " mask ") == 0
assert strpos(" `j40_rmatrices' ", " preperiods ") == 0

assert _N == `j40_N'
assert c(k) == `j40_k'
if `j40_k' > 0 {
    quietly datasignature
    assert `"`r(datasignature)'"' == `"`j40_data'"'
}
assert `"`c(rngstate)'"' == `"`j40_rng'"'
display as result "joint040 public API checks passed"
