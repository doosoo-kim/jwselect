void jw_test_reselect_search()
{
struct jw_rs_context scalar C
struct jw_rs_search_result scalar L, U
real matrix starts
real colvector h
real rowvector ranks
C.reportB = (1,2)
C.selectB = (0,0)
C.constant = 0
C.component = 1
C.groups = 1
C.EH = J(5,2,0)
C.baseline = (-2 \ -1 \ 0 \ 1 \ 2)
C.projection = J(5,1,0)
h = (.2 \ -.1)
starts = (0,1,-1 \ 0,0,0)
// Linear quantile shift: exact extrema are +/- (2+sqrt(5)).
L = jw_rs_search(C,h,I(2),starts,.1,0,1,4000,1e-5)
U = jw_rs_search(C,h,I(2),starts,.1,0,2,4000,1e-5)
assert(abs(L.value-(-2-sqrt(5))) < 1e-4)
assert(abs(U.value-(2+sqrt(5))) < 1e-4)
assert(sum(L.x:^2)<=1+1e-12 & sum(U.x:^2)<=1+1e-12)
assert(L.evaluations<=4000 & U.evaluations<=4000)
assert(L.starts==3 & U.starts==3)
ranks = jw_rs_quantile_ranks(1000,0.0195,6.2500000000000001e-05)
assert(ranks[1]==5 & ranks[2]==39)
assert(abs(jw_rs_probability_upper(3,1000,6.2500000000000001e-05)-0.016371597324061134) < 1e-10)
ranks = jw_rs_quantile_ranks(100,.0195,.001/16)
assert(ranks[1]==0)
}
jw_test_reselect_search()
